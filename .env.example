# ==============================================================================
# EchoLoop Production Environment Variables
# ==============================================================================

# Google Gemini API Key (Required for /api/parse-voice serverless endpoint)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Configuration (Required for cloud Auth and PostgreSQL persistence)
# Obtain from your project settings at https://supabase.com/
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Optional Server-Side Service Role Key (NEVER expose to frontend; for admin tasks only)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
